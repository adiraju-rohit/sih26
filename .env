
GROQ_API_KEY=

FLASK_SECRET_KEY=change-this-to-a-random-string

DB_PATH=

KNOWLEDGE_FILE=data/knowledge.txt

GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3

GROQ_SEARCH_MODEL=groq/compound

ANSWER_MODE=web

ESP_API_KEY=

# --- Text-to-speech priority: Bhashini -> espeak-ng -> Groq TTS ----------
# See the "Bhashini (ULCA)" section below for BHASHINI_* setup. espeak-ng
# just needs to be installed on the server (sudo apt-get install
# espeak-ng / brew install espeak-ng) - no env vars needed. Groq TTS uses
# your GROQ_API_KEY above; it's English-only (Groq doesn't currently offer
# Hindi/Bengali/Marathi/Telugu/Tamil/Gujarati/Kannada/Malayalam/Punjabi
# voices), so it's skipped automatically for every other supported
# language rather than producing mispronounced audio.
# GROQ_TTS_MODEL=playai-tts
# GROQ_TTS_VOICE=Fritz-PlayAI

# --- Bhashini (ULCA) - optional -------------------------------------------
# If set, translation tries Bhashini first (better quality for Indian
# languages), falling back automatically to Groq if a call fails or this
# is left blank. Text-to-speech tries Bhashini FIRST (see priority chain
# above). Speech recognition always goes through Groq Whisper, since
# Bhashini's ASR needs the source language specified up front and can't
# auto-detect it the way Whisper does - see modl.py for details.
#
# Get these by logging into https://bhashini.gov.in/ulca/profile (also
# branded "Udyat" - same portal, same credentials) -> "My Profile":
#   - BHASHINI_USER_ID: shown on the My Profile page itself, separate from
#     the generated API keys below it.
#   - BHASHINI_ULCA_API_KEY: the key value from the "API Key" / "Generate"
#     section on the same page (sometimes just called your "Udyat key" -
#     it's the same credential either way).
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
# Optional: a cached inference key, if you already have one. Not required
# for the default flow - modl.py fetches a fresh one per call using the
# two credentials above.
BHASHINI_INFERENCE_KEY=
# Optional: override the default public MeitY pipeline id.
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
